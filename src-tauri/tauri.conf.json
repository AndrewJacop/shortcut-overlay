{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shortcut-overlay",
  "version": "0.1.0",
  "identifier": "com.shortcut-overlay.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ShortcutOverlay",
        "width": 700,
        "height": 560,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "transparent": true
      },
      {
        "label": "settings",
        "title": "ShortcutOverlay — Settings",
        "url": "index.html#settings",
        "width": 680,
        "height": 540,
        "visible": false,
        "skipTaskbar": false,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
